# Analytics. Leave blank to disable: the site renders no analytics code at all.
NEXT_PUBLIC_GTM_ID=

# Error reporting. Leave blank to disable Sentry entirely.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# Public origin, used for canonicals, sitemap and JSON-LD @id values.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
