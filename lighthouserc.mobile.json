{
  "ci": {
    "collect": {
      "startServerCommand": "npx next start --port 3202",
      "url": [
        "http://127.0.0.1:3202/"
      ],
      "numberOfRuns": 3,
      "settings": {
        "throttlingMethod": "simulate"
      }
    },
    "assert": {
      "assertions": {
        "largest-contentful-paint": [
          "error",
          {
            "maxNumericValue": 2500
          }
        ],
        "cumulative-layout-shift": [
          "error",
          {
            "maxNumericValue": 0.1
          }
        ],
        "total-blocking-time": [
          "error",
          {
            "maxNumericValue": 200
          }
        ]
      },
      "aggregationMethod": "median"
    }
  }
}
